PORT=8083
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=planning
DB_SSL=false

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
# Clé de chiffrement AES-256-GCM pour les secrets TOTP (32 octets = 64 caractères hex)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=cle_hex_de_64_caracteres_pour_chiffrement_aes_256_gcm_totp

# Email Configuration
# Option A : Brevo API HTTPS (RECOMMANDÉ SUR RENDER & CLOUD)
# Render bloque les ports SMTP sortants (25, 465, 587) provoquant des "Connection timeout".
# Ce mode utilise l'API HTTPS (port 443) sans passer par SMTP.
# EMAIL_PROVIDER=brevo-api
# BREVO_API_KEY=xkeysib-votre_cle_api_v3_brevo_ici
# EMAIL_FROM="GMT Ariana" <adresse-verifiee-chez-brevo@votre-domaine.tn>
# EMAIL_REPLY_TO=contact@votre-domaine.tn

# Option B : Brevo (Sendinblue) SMTP (Par défaut si EMAIL_PROVIDER non défini)
# Recommandé pour serveurs dédiés ou VPS où les ports SMTP 587/465 ne sont pas bloqués
# EMAIL_PROVIDER=brevo (ou laisser non défini)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=votre_login_smtp_brevo
# EMAIL_PASS=votre_cle_smtp
# EMAIL_FROM="GMT Ariana" <no-reply@votre-domaine.tn>
# EMAIL_REPLY_TO=contact@votre-domaine.tn

# Option C : Mode Gmail Dédié SMTP (Activé UNIQUEMENT si EMAIL_PROVIDER=gmail)
# Usage interne réservé pour développement local, ~500 emails/jour max.
# Utilise le transport Nodemailer service:'gmail' avec EMAIL_USER et EMAIL_PASS (mot de passe d'application 16 caractères).
# Note : Sur Render, Gmail SMTP est souvent bloqué par timeout (utilisez brevo-api sur Render).
# EMAIL_PROVIDER=gmail
# EMAIL_USER=votre-adresse@gmail.com
# EMAIL_PASS=mot_de_passe_application_16_caracteres
# EMAIL_FROM="GMT Ariana" <votre-adresse@gmail.com>
# EMAIL_REPLY_TO=votre-adresse@gmail.com

# Option D : Resend API HTTPS (Alternative HTTPS port 443)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_votre_cle_api_resend_ici
# EMAIL_FROM="GMT Ariana" <onboarding@resend.dev> ou votre domaine vérifié


# Web Push Notifications (VAPID) — Optionnel (généré automatiquement dans backend/config/vapid.json si non fourni)
# VAPID_PUBLIC_KEY=votre_cle_publique_vapid
# VAPID_PRIVATE_KEY=votre_cle_privee_vapid
# VAPID_EMAIL=mailto:contact@gmt-ariana.tn

# Twilio SMS Configuration (Optionnel)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Swagger / OpenAPI Documentation (Sécurité DevOps en Production)
# SWAGGER_ENABLED=true  # Activer en production (par défaut activé en dev)
# SWAGGER_USER=admin_swagger
# SWAGGER_PASS=mot_de_passe_robuste_swagger

# Authentification Biométrique & Passkeys (WebAuthn / FIDO2)
# En production, obligatoire et l'origine doit impérativement utiliser HTTPS.
# En développement : localhost accepté.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="GMT Ariana — Santé au Travail"
WEBAUTHN_ORIGIN=http://localhost:5173

